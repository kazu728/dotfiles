#!/usr/bin/env bash
set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  echo "claude not found in PATH" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)

skill_file=""
for candidate in \
  "$repo_root/.claude/skills/aicommit/SKILL.md" \
  "$HOME/.claude/skills/aicommit/SKILL.md"; do
  if [ -f "$candidate" ]; then
    skill_file=$candidate
    break
  fi
done

if [ -z "$skill_file" ]; then
  echo "aicommit skill not found. Run 'make skills' in dotfiles." >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  if git diff --cached --quiet; then
    echo "No staged changes. Run git add first." >&2
    exit 1
  fi
  prompt='/aicommit staged な変更をコミットしてください。'
else
  printf -v extra_args '%q ' "$@"
  prompt="/aicommit コミットしてください。指定された引数: ${extra_args% }（非対話実行のため確認質問はせず、中止が必要な場合のみ理由を返してください）"
fi

before_head=$(git rev-parse --verify --quiet HEAD || true)

(
  cd "$repo_root"
  claude \
    --print \
    --no-session-persistence \
    --model haiku \
    --effort low \
    --dangerously-skip-permissions \
    "$prompt"
)

if [ $# -eq 0 ]; then
  after_head=$(git rev-parse --verify --quiet HEAD || true)
  if [ "$after_head" = "$before_head" ]; then
    exit 1
  fi
fi
