#!/usr/bin/env bash
set -euo pipefail

if ! command -v codex >/dev/null 2>&1; then
  echo "codex not found in PATH" >&2
  exit 1
fi

if git diff --cached --quiet; then
  echo "No staged changes. Run git add first." >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
recent_subjects=$(git log --no-merges -n 20 --pretty=format:'%s' 2>/dev/null || true)
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM
aicommit_skill=$HOME/.agents/skills/aicommit/SKILL.md
repo_aicommit_skill=$repo_root/.agents/skills/aicommit/SKILL.md

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
policy_file=""
policy_candidates=()

if [ -n "${GIT_AICOMMIT_SUBJECT_POLICY:-}" ]; then
  policy_candidates+=("$GIT_AICOMMIT_SUBJECT_POLICY")
fi

if [ -n "${XDG_DATA_HOME:-}" ]; then
  policy_candidates+=("$XDG_DATA_HOME/git-aicommit/subject-policy.md")
elif [ -n "${HOME:-}" ]; then
  policy_candidates+=("$HOME/.local/share/git-aicommit/subject-policy.md")
fi

policy_candidates+=("$script_dir/../agents/.apm/skills/aicommit/subject-policy.md")

for candidate in "${policy_candidates[@]}"; do
  if [ -f "$candidate" ]; then
    policy_file=$candidate
    break
  fi
done

if [ -z "$policy_file" ]; then
  echo "subject-policy.md not found. Set GIT_AICOMMIT_SUBJECT_POLICY or install dotfiles." >&2
  exit 1
fi

subject_policy=$(cat "$policy_file")
staged_paths=$(git diff --cached --no-renames --name-only -z | jq -Rs 'split("\u0000")[:-1]')

# Options for git commit describe a single commit, and splitting rebuilds the index from HEAD.
if [ $# -eq 0 ] && git rev-parse --verify --quiet HEAD >/dev/null; then
  can_split=true
  split_rule="Plan one commit unless the diff mixes changes with clearly different purposes. When splitting, keep a renamed file's old and new paths together, and keep files that reference each other's changed code in the same commit so that every commit builds on its own."
else
  can_split=false
  split_rule="Plan exactly one commit."
fi

prompt=$(cat <<EOF
Plan git commits for the staged diff provided in the <stdin> block.

$split_rule
Assign every staged path to exactly one commit:
$staged_paths

Recent commit subjects from this repository:
$recent_subjects

Subject policy, which applies to each commit's subject:
$subject_policy
EOF
)

cat >"$tmpdir/schema.json" <<'EOF'
{
  "type": "object",
  "properties": {
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["subject", "paths"],
        "additionalProperties": false
      }
    }
  },
  "required": ["commits"],
  "additionalProperties": false
}
EOF

# Pipe the diff instead of asking the model to run git diff; it sometimes skips the tool call and invents a subject.
# This prompt matches the aicommit skill, so disable it to prevent a recursive commit attempt.
git diff --cached | codex exec -C "$repo_root" --sandbox read-only --ephemeral \
  -m gpt-6-luna \
  -c 'model_reasoning_effort="low"' \
  -c "skills.config=[{path=\"$aicommit_skill\",enabled=false},{path=\"$repo_aicommit_skill\",enabled=false}]" \
  --output-schema "$tmpdir/schema.json" \
  -o "$tmpdir/plan.json" \
  "$prompt" \
  >/dev/null

plan=$tmpdir/plan.json
if ! jq -e --argjson staged "$staged_paths" --argjson can_split "$can_split" '
  (.commits | length) as $n
  | all(.commits[]; .subject | length > 0 and (test("[\r\n]") | not))
    and ($n == 1 or ($can_split and $n > 1
      and all(.commits[]; .paths | length > 0)
      and ([.commits[].paths[]] | sort) == ($staged | sort)))
' "$plan" >/dev/null 2>&1; then
  printf 'Codex returned an invalid commit plan:\n%s\n' "$(cat "$plan")" >&2
  exit 1
fi

count=$(jq '.commits | length' "$plan")
if [ "$count" -eq 1 ]; then
  git commit -m "$(jq -r '.commits[0].subject' "$plan")" "$@"
  exit
fi

staged_tree=$(git write-tree)
start=$(git rev-parse HEAD)
for ((i = 0; i < count; i++)); do
  paths=()
  while IFS= read -r -d '' path; do
    paths+=("$path")
  done < <(jq -j --argjson i "$i" '.commits[$i].paths[] + "\u0000"' "$plan")
  if ! {
    git read-tree HEAD &&
      git --literal-pathspecs diff --binary HEAD "$staged_tree" -- "${paths[@]}" | git apply --cached &&
      git commit -m "$(jq -r --argjson i "$i" '.commits[$i].subject' "$plan")"
  }; then
    git read-tree "$staged_tree"
    echo "Commit $((i + 1)) of $count failed. The index is back to the staged changes. Commits already made:" >&2
    git log --oneline "$start"..HEAD >&2
    exit 1
  fi
done

if ! git diff --quiet HEAD "$staged_tree"; then
  echo "The commits differ from the staged changes, likely rewritten by a hook:" >&2
  git diff --stat HEAD "$staged_tree" >&2
fi
