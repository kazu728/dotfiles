theme = Atom

cursor-style-blink = false
confirm-close-surface = false
macos-option-as-alt = true

font-family = "Monaco"
font-size = 11.5

keybind = shift+enter=text:\n
keybind = cmd+t=text:\x02c
keybind = cmd+w=text:\x02x
keybind = cmd+shift+[=text:\x02p
keybind = cmd+shift+]=text:\x02n
keybind = cmd+physical:one=text:\x021
keybind = cmd+physical:two=text:\x022
keybind = cmd+physical:three=text:\x023
keybind = cmd+physical:four=text:\x024
keybind = cmd+physical:five=text:\x025
keybind = cmd+physical:six=text:\x026
keybind = cmd+physical:seven=text:\x027
keybind = cmd+physical:eight=text:\x028
keybind = cmd+physical:nine=text:\x029
keybind = cmd+d=text:\x02v
keybind = cmd+shift+d=text:\x02-
keybind = cmd+shift+enter=text:\x02z
keybind = cmd+]=text:\x02\t
keybind = cmd+[=text:\x02\x1b[Z
keybind = cmd+alt+left=text:\x02h
keybind = cmd+alt+down=text:\x02j
keybind = cmd+alt+up=text:\x02k
keybind = cmd+alt+right=text:\x02l
keybind = cmd+b=text:\x02b

font-feature = -calt
font-feature = -dlig
